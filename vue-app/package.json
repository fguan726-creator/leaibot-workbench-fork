{
  "name": "leaibot-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "guard:design-skill": "node scripts/verify-design-skill.mjs",
    "dev": "node scripts/verify-design-skill.mjs && node --test scripts/product-contract-regression.test.mjs && vite",
    "build": "node scripts/verify-design-skill.mjs && node --test scripts/product-contract-regression.test.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:product-contract": "node --test scripts/product-contract-regression.test.mjs",
    "test:design-skill-guard": "node --test scripts/design-skill-guard.test.mjs",
    "test:scenario-skill-packages": "node --test scripts/scenario-skill-packages.test.mjs scripts/scenario-skill-package-graph.test.mjs",
    "test:application-info": "node scripts/test-application-info.mjs",
    "test:account-enable": "node scripts/test-account-enable-request.mjs",
    "test:poc-login": "node scripts/test-poc-external-login.mjs && node --test scripts/poc-enable-state-regression.test.mjs",
    "test:poc-enable-state:browser": "node scripts/verify-poc-enable-state-browser.mjs",
    "test:poc-login:browser": "node scripts/verify-poc-login-picker-browser.mjs",
    "test:account-enable:browser": "node scripts/verify-account-enable-request-browser.mjs",
    "test:account-request-status:browser": "node scripts/verify-account-request-status-browser.mjs",
    "test:permission-scope": "node --experimental-strip-types scripts/test-permission-scope.mjs",
    "test:user-management": "node scripts/test-user-management.mjs",
    "test:custom-table-authorization": "node scripts/test-custom-table-authorization.mjs",
    "test:custom-data-role-conflict": "node scripts/test-custom-data-role-conflict.mjs",
    "test:custom-table-authorization:browser": "node scripts/verify-custom-table-authorization-browser.mjs",
    "test:user-management:browser": "node scripts/verify-user-management-browser.mjs",
    "test:permission-scope:browser": "node scripts/verify-permission-scope-browser.mjs",
    "test:login-password-recovery:browser": "node scripts/verify-login-password-recovery-browser.mjs",
    "smoke:shell": "node scripts/smoke-shell.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "echarts": "^5.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.3.3",
    "sass": "^1.77.0",
    "typescript": "^5.5.4",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.29"
  }
}
